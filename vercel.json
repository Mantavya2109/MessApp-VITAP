{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "frontend": {
            "root": "frontend/",
            "framework": "vite"
        },
        "backend": {
            "root": "backend/",
            "framework": "express",
            "entrypoint": "src/server.mts",
            "installCommand": "npm ci",
            "buildCommand": "npm run build"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}