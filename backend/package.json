{
  "name": "backend",
  "version": "1.0.0",
  "description": "MessApp VIT-AP Menu API and Database",
  "main": "dist/server.mjs",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.mts",
    "build": "node build.js",
    "start": "node dist/server.mjs",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "import:dry-run": "tsx src/importer/importMenu.ts --dry-run",
    "import:menu": "tsx src/importer/importMenu.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "esbuild": "^0.25.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}